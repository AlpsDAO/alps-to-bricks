    "@types/three": "^0.186.0",
    "esbuild": "0.28.2",
    "jpeg-js": "^0.4.4",
    "playwright-core": "^1.63.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "jspdf": "^4.2.1",
